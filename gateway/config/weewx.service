[Unit]
Description=WeeWX Weather Station
After=wx-gateway.service
Wants=wx-gateway.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/weewx-data

ExecStart=/home/pi/weewx-venv/bin/weewxd --config=/home/pi/weewx-data/weewx.conf

Restart=on-failure
RestartSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
